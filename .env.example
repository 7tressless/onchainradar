# OCR environment template. Copy to .env (gitignored) and fill real values.

# --- chain ---
MANTLE_RPC_URL=https://rpc.mantle.xyz
CHAIN_ID=5000
POLL_INTERVAL_SEC=3
CONFIRMATIONS=2          # reorg/finality depth: blocks trimmed off the head before final. >= 0 (0 = no lag)

# --- storage ---
DATABASE_URL=postgres://ocr:ocr@localhost:5432/ocr?sslmode=disable

# --- telegram ---
TG_BOT_TOKEN=
TG_CHANNEL_ID=

# --- attestation ---
AGENT_PRIVATE_KEY=
ATTESTOR_ADDRESS=
# OutcomeAttestor (sidecar): records each matured outcome report card on-chain so the
# agent's hit-rate is verifiable. Optional: empty disables it (outcomes still measured
# off-chain). Reuses AGENT_PRIVATE_KEY; the hourly + idempotent attest re-sends a dropped
# tx next pass, so sharing the key is fine (use a separate wallet for strict isolation).
OUTCOME_ATTESTOR_ADDRESS=

# --- llm (OpenAI-compatible endpoint) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- external market data (display/discovery only, never detection) ---
# Optional CoinGecko demo API key. When set, discover + poolstats use the CoinGecko onchain
# endpoint at its higher rate limit (the keyless GeckoTerminal root 429s). Empty = keyless.
GECKO_API_KEY=

# --- detector tunables ---
Z_THRESHOLD=4.0
BUCKET_MIN=5
BASELINE_BUCKETS=576
COOLDOWN_MIN=60
WHALE_MIN_MULTIPLE=25   # a whale swap must be >= this multiple of the pool's median swap size
OUTCOME_HORIZON_HOURS=6 # hours to wait before grading a signal's outcome (post vs pre baseline)

# --- smart-money detector (signal_type 3) ---
SMART_MONEY_SIZE_MULTIPLE=5       # a swap counts as "large" at >= this multiple of the pool's median swap size
SMART_MONEY_MIN_SWAPS=2           # min large swaps by one wallet in the window to count as accumulation
SMART_MONEY_WINDOW_HOURS=24       # accumulation window: count a wallet's large swaps over the last N hours
SMART_MONEY_THRESHOLD=50          # 0..100 composite score gate; a candidate fires only at or above this
SMART_MONEY_COOLDOWN_MIN=240      # per-ACTOR cooldown (min): one actor fires at most once per this window (0=off)
SMART_MONEY_MIN_DIRECTIONALITY=0.5 # hard net-direction floor [0,1): max over tokens of |net|/gross; below this = churn, excluded

# --- lending detector (Aave V3; signal_type 5 = liquidation, 6 = big_borrow) ---
# A signal per liquidation (liquidator = smart money) and per large borrow. Both gates are
# absolute USD floors (lending events are sparse -> no z-score). The USD figure comes only
# from our decoded amount + the verified stablecoin set, never an external price.
BIG_BORROW_MIN_USD=50000          # a single Aave borrow must be >= this USD to fire (stable reserves only; non-stable can't be sized -> never fires)
LIQUIDATION_MIN_USD=0             # a liquidation must be >= this USD to fire. 0 = any liquidation fires (default); a positive floor excludes non-stable-debt liquidations (unsized)

# --- LST-flow detector (signal_type 4 = lst_flow) ---
# Large mETH / cmETH ERC-20 Transfers, classified by counterparty into mint / burn / move.
# Transfers where either side is a tracked DEX pool are skipped (already in the swap
# signals). The gate is a whole-token floor; the display-only USD size is filled from the
# token's market price when one is known.
LST_FLOW_MIN_TOKENS=10            # an mETH/cmETH transfer must be >= this many whole tokens (18-dec) to fire. Must be > 0
LST_FLOW_WINDOW_MIN=30            # per-actor aggregation window (min): a wallet's later transfers fold into its open signal. 0 = off

# --- depeg detector (signal_type 7 = depeg) ---
# Watches stable/stable pools and flags a depeg when the median implied price of our swaps
# drifts off the 1.0 peg, then maps the contagion (other pools holding the token). The
# implied price comes only from our decoded swaps + the verified stable set + pool
# decimals; never an external price / oracle.
DEPEG_THRESHOLD_BPS=50            # fire when the median implied price is >= this many bps off the 1.0 peg (50 = 0.5%). Must be > 0
DEPEG_MIN_SWAPS=5                 # require >= this many usable swaps in the window before trusting the implied price. Must be > 0
DEPEG_COOLDOWN_MIN=60             # per-TOKEN cooldown (min): one depegging token fires at most once per this window (0=off, bucket idempotency still throttles)

# --- pool auto-discovery (`ocr discover`) ---
# The gate is an OR: a candidate is proposed when reserve clears DISCOVER_MIN_LIQUIDITY_USD
# OR 24h volume clears DISCOVER_MIN_VOL24_USD, so a high-volume lower-TVL pool stays
# eligible. Coarse shortlist gates only; tokens/decimals/ordering/anchor are re-derived on-chain.
DISCOVER_MIN_LIQUIDITY_USD=100000 # reserve (TVL) floor (USD). Must be >= 0 (0 = no reserve floor).
DISCOVER_MIN_VOL24_USD=250000     # 24h traded-volume floor (USD): the alternative that rescues a
                                  # sub-floor-TVL pool. Must be >= 0 (0 = disable the volume side).

# --- pool market stats (`poolstats` stage / `ocr poolstats`) ---
POOL_STATS_INTERVAL_MIN=10        # refresh each pool's display-only market snapshot from GeckoTerminal
                                  # every N min (0 disables). Display only; never feeds detection.

# --- read-only JSON API + SSE live feed (`ocr serve`) ---
# API_ADDR binds the JSON API under /api/ + the SSE feed at /api/live. Default
# 0.0.0.0:7070 (public, read-only); for local dev use 127.0.0.1:7070 over an SSH tunnel.
# Legacy DASHBOARD_ADDR is still honored as a fallback.
API_ADDR=0.0.0.0:7070
# Per-IP req/sec budget for /api/* (burst is a small multiple), keyed on RemoteAddr
# (X-Forwarded-For not trusted). Default 20. 0 disables. Must be >= 0.
API_RATE_LIMIT_RPS=20

# --- silent-stall watchdog (supervisor `run`) ---
# If the freshest ingested activity lags wall-clock by more than this many minutes, the
# watchdog emits one throttled WARN (and Telegram alert if configured), re-alerting at most
# hourly, so a wedged collector/RPC surfaces instead of failing silently. Default 15. 0 disables.
STALL_ALERT_MIN=15
